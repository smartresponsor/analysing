{
  "name": "analysing/analytics",
  "description": "Analysing process package",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Oleksandr Tishchenko",
      "email": "dev@highhopesamerica.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "administering/administration": "dev-master",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "tabling/table": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/framework-bundle": "^8.1",
    "symfony/console": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/options-resolver": "^8.1",
    "symfony/yaml": "^8.1",
    "doctrine/orm": "^3.3",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "psr/log": "^3.0",
    "ext-zlib": "*",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.20",
    "symfony/var-dumper": "^8.1",
    "symfony/test-pack": "^1.2",
    "symfony/panther": "^2.4",
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "fakerphp/faker": "^1.24",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Analysing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Analysing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "scan": "php tools/analytics-scan-layer-map.php",
    "lint:canon": "php tools/analytics-scan-layer-map.php",
    "guard:interfaceinterface": "php tools/analytics-interfaceinterface-guard.php",
    "guard:namespace": "php tools/analytics-namespace-guard.php --mode=report",
    "gate": "@php vendor/bin/gating check --target=. --profile=.gating/profile/component/analysing.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text=var/coverage/summary.txt"
    ],
    "qa:env": "php tools/qa/AnalyticsQaEnvironmentCheck.php",
    "test": [
      "@qa:env",
      "phpunit"
    ],
    "analyse": "phpstan analyse src --level=max",
    "standalone:smoke": "@php bin/console about --env=test",
    "schema:validate": "@php bin/console doctrine:schema:validate --env=test",
    "schema:parity": [
      "@schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "fix": "php-cs-fixer fix --allow-risky=yes",
    "clean:config-garbage": "php tools/analytics-config-garbage-clean.php",
    "purge:interfaceinterface": "php tools/analytics-interfaceinterface-purge.php",
    "guard:domain-hygiene": "php tools/analytics-domain-hygiene-guard.php",
    "guard:php-header": "php tools/analytics-php-header-guard.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Administering",
      "options": {
        "symlink": true,
        "versions": {
          "administering/administration": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    }
  ]
}

