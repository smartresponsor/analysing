{
    "name": "smartresponsor/analytics",
    "description": "Analytics — domain analytics, dashboards, alerts, and exporters for SmartResponsor ecosystem.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Oleksandr Tishchenko",
            "email": "dev@smartresponsor.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.3 || ^7.0",
        "symfony/console": "^6.3 || ^7.0",
        "symfony/http-foundation": "^6.3 || ^7.0",
        "symfony/http-client": "^6.3 || ^7.0",
        "symfony/dependency-injection": "^6.3 || ^7.0",
        "doctrine/orm": "^2.15 || ^3.0",
        "doctrine/dbal": "^3.6",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.20",
        "symfony/var-dumper": "^6.3 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=max",
        "fix": "php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
