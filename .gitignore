# ──────────────────────────────────────────────
#  💻 OS & IDE junk
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.iml
.idea/*
# ──────────────────────────────────────────────
#  🐘 PHP / Composer
# ──────────────────────────────────────────────
/vendor/
/composer.lock
/composer.phar
/.phpunit.cache
/phpunit.result.cache

# ──────────────────────────────────────────────
#  🧩 Symfony cache, logs, temp
# ──────────────────────────────────────────────
/var/cache/
/var/log/
/var/sessions/
/var/test/
/var/tmp/
/var/export/
/var/data/
/var/backups/
/var/build/
/var/storage/
/var/metrics/
/var/runtime/

# ──────────────────────────────────────────────
#  📦 Node / Frontend
# ──────────────────────────────────────────────
/node_modules/
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# ──────────────────────────────────────────────
#  🧪 Tests / Coverage
# ──────────────────────────────────────────────
/coverage/
/build/
/reports/
/report/
/test-output/
.cachegrind.out.*

# ──────────────────────────────────────────────
#  🚀 CI/CD generated
# ──────────────────────────────────────────────
/dist/
/downloads/
/public/api/
/public/dev/
/public/coverage/
/docs/export/
/docs/releases/
/tmp/
/cache/
/artifacts/

# ──────────────────────────────────────────────
#  🧰 Temporary & Backup files
# ──────────────────────────────────────────────
*.tmp
*.bak
*.old
*.orig
*.log
*~
# PHP-CS-Fixer cache
.php-cs-fixer.cache

# ──────────────────────────────────────────────
#  🔐 Local environment (never commit)
# ──────────────────────────────────────────────
.env.local
.env.test.local
.env.*.local
/.env.backup
/.envrc
/.env.secrets
/.env.private
/.env.cache

# ──────────────────────────────────────────────
#  📁 User / app storage
# ──────────────────────────────────────────────
/storage/
/runtime/
/uploads/
/media/
/cache_private/

# ──────────────────────────────────────────────
#  ⚙️ System / Misc
# ──────────────────────────────────────────────
*.pid
*.seed
*.sqlite*
*.db
*.sql
*.log.*
*.gz
*.zip
*.tar
*.tar.gz
*.7z

# ──────────────────────────────────────────────
#  📦 Build outputs from CI (keep CI scripts)
# ──────────────────────────────────────────────
!/.github/
!/.github/workflows/
!/.yamllint.yml
!/.editorconfig
!/.gitattributes
!/.php-cs-fixer.cache
!/var/metrics/

/.tmp.drivedownload/
/.tmp.driveupload/

# keep env template
!.env.dist

# Linters
!/.php-cs-fixer.php
!/ecs.php
!/rector.php
!/phpstan.neon
!/phpstan.neon.dist

/archives/
/Archives/

# Analytics generated/runtime state
/config/reference.php
/var/analytics_idempotency/
/var/analytics_rate_limit/
/var/analytics_rate_limit_smoke/
/var/*.sqlite
/var/.php-cs-fixer.cache
/var/coverage/
*.bak-*

# Local materialized Gating pack; track only the component-owned profile.
/.gating/*
!/.gating/profile/
!/.gating/profile/component/
!/.gating/profile/component/analysing.yaml

# One-off CMCP migration utilities retained locally as execution evidence only.
/tools/analytics-canonical-role-first-migrate.php
/tools/analytics-canonical-reference-reconcile.php
/tools/analytics-canonical-reference-recover.php
/tools/analytics-remove-empty-legacy-roots.php
/tool/cmcp-unstage-noise.ps1
/tool/cmcp-playwright-diagnose.ps1
/tool/cmcp-git-identity.ps1
/test-results/
/.console-mcp/
